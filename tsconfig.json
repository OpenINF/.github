{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "typeRoots": ["${configDir}/node_modules/@types"]
  },
  // Without this the project takes in whatever tsc would emit. That costs
  // nothing while only .ts and .mts are read, but it means anyone reaching for
  // allowJs starts type-checking build output by accident.
  "exclude": ["lib"]
}
