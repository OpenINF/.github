{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "presentation": {
    "echo": false,
    "reveal": "always",
    "focus": false,
    "panel": "dedicated",
    "showReuseMessage": true
  },
  "tasks": [
    {
      "label": "Create fish shell terminal",
      "dependsOn": ["fish"],
      // Try to start the task on folder open.
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      // The name that shows up in terminal tab.
      "label": "fish",
      // The task will launch a shell.
      "type": "shell",
      "command": "echo 'greets'",
      // Set the shell type.
      "options": {
        "shell": {
          "executable": "fish",
          "args": ["-c"]
        }
      },
      // Mark as a background task to avoid the spinner animation on the
      // terminal tab.
      "isBackground": true,
      "problemMatcher": []
    },
    {
      // Every check the pull request has to pass, which is what CI runs.
      "label": "Verify all",
      "type": "shell",
      "command": "nps test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      // The autofixable half of the same set.
      "label": "Format all",
      "type": "shell",
      "command": "nps format.all",
      "problemMatcher": []
    }
  ]
}
